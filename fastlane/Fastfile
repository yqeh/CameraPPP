# Fastfile - CameraPPP TestFlight 自動部署

default_platform(:ios)

platform :ios do
  desc "建置並上傳至 TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY"],
      is_key_content_base64: true
    )

    # 使用 GitHub Actions 流水號作為 Build Number，避免重複上傳
    if ENV["GITHUB_RUN_NUMBER"]
      increment_build_number(
        build_number: ENV["GITHUB_RUN_NUMBER"],
        xcodeproj: "CameraPPP.xcodeproj"
      )
    end

    update_code_signing_settings(
      use_automatic_signing: true,
      team_id: "HK77JRQQ85",
      path: "CameraPPP.xcodeproj",
      targets: ["CameraPPP"],
      code_sign_identity: "Apple Distribution"
    )

    build_app(
      project: "CameraPPP.xcodeproj",
      scheme: "CameraPPP",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "CameraPPP.ipa",
      clean: true,
      xcargs: "-allowProvisioningUpdates DEVELOPMENT_TEAM=HK77JRQQ85",
      export_options: {
        method: "app-store",
        signingStyle: "automatic",
        teamID: "HK77JRQQ85"
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
